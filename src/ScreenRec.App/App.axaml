<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ScreenRec.App.App"
             Name="ScreenRec Trainer"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style Selector="TextBlock.muted"><Setter Property="Opacity" Value="0.7"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="#D13438"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style Selector="Border.card"><Setter Property="Padding" Value="16"/><Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#40808080"/></Style>
    </Application.Styles>
</Application>
